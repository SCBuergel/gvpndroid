index 00000000..1c830ca9
--- /dev/null
+++ b/gnosis_vpn-lib/src/killswitch/android.rs
@@ -0,0 +1,40 @@
+//! Android has no app-controlled firewall. The kill switch is the system setting
+//! "Always-on VPN" + "Block connections without VPN", so every policy call is a no-op.
+
+use std::net::IpAddr;
+
+use thiserror::Error;
+
+#[derive(Debug, Error)]
+pub enum Error {
+    #[error("{0}")]
+    Unsupported(String),
+}
+
+pub struct Firewall;
+
+impl Firewall {
+    pub fn new() -> Result<Self, Error> {
+        Ok(Firewall)
+    }
+
+    pub fn capture_recovery_state(&mut self) -> Result<Option<bool>, Error> {
+        Ok(None)
+    }
+
+    pub fn apply_policy(&mut self, _interface: Option<&str>, _allowed_ips: &[IpAddr], _lan_lockdown: bool) -> Result<(), Error> {
+        Ok(())
+    }
+
+    pub fn reapply_policy(&mut self, _interface: Option<&str>, _allowed_ips: &[IpAddr], _lan_lockdown: bool) -> Result<(), Error> {
+        Ok(())
+    }
+
+    pub fn reset_policy(&mut self) -> Result<(), Error> {
+        Ok(())
+    }
+
+    pub fn reset_policy_with_state(&mut self, _was_enabled: Option<bool>) -> Result<(), Error> {
+        Ok(())
+    }
+}
