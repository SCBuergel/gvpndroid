@@ -0,0 +1,53 @@
+//! Android has no app-controlled firewall. The kill switch is the system setting
+//! "Always-on VPN" + "Block connections without VPN", so every policy call is a no-op; the
+//! tunnel stages (TunnelAccess) are applied in the pump instead (wg_tunnel::tap).
+
+use std::net::IpAddr;
+
+use super::TunnelAccess;
+
+use thiserror::Error;
+
+#[derive(Debug, Error)]
+pub enum Error {
+    #[error("{0}")]
+    Unsupported(String),
+}
+
+pub struct Firewall;
+
+impl Firewall {
+    pub fn new() -> Result<Self, Error> {
+        Ok(Firewall)
+    }
+
+    pub fn capture_recovery_state(&mut self) -> Result<Option<bool>, Error> {
+        Ok(None)
+    }
+
+    pub fn apply_policy(
+        &mut self,
+        _tunnel: &TunnelAccess,
+        _allowed_ips: &[IpAddr],
+        _lan_lockdown: bool,
+    ) -> Result<(), Error> {
+        Ok(())
+    }
+
+    pub fn reapply_policy(
+        &mut self,
+        _tunnel: &TunnelAccess,
+        _allowed_ips: &[IpAddr],
+        _lan_lockdown: bool,
+    ) -> Result<(), Error> {
+        Ok(())
+    }
+
+    pub fn reset_policy(&mut self) -> Result<(), Error> {
+        Ok(())
+    }
+
+    pub fn reset_policy_with_state(&mut self, _was_enabled: Option<bool>) -> Result<(), Error> {
+        Ok(())
+    }
+}
